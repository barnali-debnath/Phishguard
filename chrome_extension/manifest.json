{
  "manifest_version": 3,

  "name": "PhishGuard",

  "version": "1.0",

  "description": "AI-powered phishing detector",

  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },
  
  "web_accessible_resources": [
  {
    "resources": [
      "dashboard/*",
      "dashboard/assets/*",
      "dashboard/*.svg",
      "dashboard/*.png",
      "dashboard/*.jpg",
      "dashboard/*.jpeg"
    ],
    "matches": ["<all_urls>"]
  }
 ]
  
}